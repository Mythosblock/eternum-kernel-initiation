name: 🦊 Coherence Audit

on:
  pull_request:
    branches: [ main ]

jobs:
  audit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: POSIX Compliance Check
        run: |
          echo "🦊 Alliance Auditor Initialized..."
          # Check for common bash-isms in shell files
          # Rejects [[ ]], local, and other non-POSIX patterns
          grep -rnE '(\[\[|local |function )' ./**/*.sh && (echo "FAIL: Non-POSIX logic detected." && exit 1) || echo "PASS: POSIX Strict."
          
      - name: Bloat Check
        run: |
          # Rejects if it sees 'npm', 'pip', or 'maven' in the diff
          git diff origin/main --unified=0 | grep -iE '(npm|pip|maven|install)' && (echo "FAIL: External dependency drift detected." && exit 1) || echo "PASS: Zero-Dependency."

      - name: Resonance Approval
        run: echo "🦊 Signal Coherent. PR Ready for Prime Operator Review."

